<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Update</title>
    <style>
        :root {
            --ink: #1f2933;
            --muted: #6b7280;
            --line: #e5e7eb;
            --paper: #ffffff;
            --canvas: #f6f7f5;
            --accent: #146c94;
            --accent-dark: #0f526f;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 48px 24px;
            background: var(--canvas);
            color: var(--ink);
            font-family: "Avenir Next", "Segoe UI", sans-serif;
        }

        .form-page {
            max-width: 720px;
            margin: 0 auto;
        }

        h1 {
            margin: 0 0 28px;
            font-family: Georgia, serif;
            font-size: clamp(2rem, 5vw, 3rem);
            font-weight: 400;
        }

        form {
            display: flex;
            flex-direction: column;
            gap: 14px;
            padding: 28px;
            border: 1px solid var(--line);
            border-radius: 8px;
            background: var(--paper);
        }

        input,
        textarea {
            width: 100%;
            padding: 13px 14px;
            border: 1px solid #cbd5d9;
            border-radius: 5px;
            background: #fff;
            color: var(--ink);
            font: inherit;
        }

        textarea {
            min-height: 240px;
            resize: vertical;
        }

        input:focus,
        textarea:focus {
            outline: 3px solid #d8edf5;
            border-color: var(--accent);
        }

        button {
            align-self: flex-start;
            padding: 11px 18px;
            border: 1px solid var(--accent);
            border-radius: 5px;
            background: var(--accent);
            color: #fff;
            font-weight: 700;
            font: inherit;
            cursor: pointer;
        }

        button:hover {
            background: var(--accent-dark);
        }

        .back-link {
            display: inline-block;
            margin-bottom: 28px;
            color: var(--accent);
            font-size: 0.9rem;
            font-weight: 700;
            text-decoration: none;
        }

        .back-link:hover {
            text-decoration: underline;
        }

        @media (max-width: 600px) {
            body {
                padding: 28px 16px;
            }

            form {
                padding: 16px;
            }
        }
    </style>
</head>
<body>
<main class="form-page">
    <a class="back-link" href="/home/admin">&larr; Dashboard</a>
    <h1>Update Article</h1>
   <form action="/home/admin/update/<%= idVal %>" method="Post">
    <input
    value="<%= title %>"
    type="text"
    name="title"
    id="title"
    placeholder="Article Title"
    >
    
    <textarea
    name="content"
    id="content"
    placeholder="Article Content"
    ><%= content %></textarea>
    
    <button type="submit">Submit</button>
   </form>
</main>
</body>
</html>