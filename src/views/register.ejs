<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Register</title>
    <style>
      :root {
        --ink: #1f2933;
        --line: #e5e7eb;
        --paper: #ffffff;
        --canvas: #f6f7f5;
        --accent: #146c94;
        --accent-dark: #0f526f;
      }

      * {
        box-sizing: border-box;
      }

      body {
        display: grid;
        min-height: 100vh;
        margin: 0;
        place-items: center;
        padding: 28px 16px;
        background: var(--canvas);
        color: var(--ink);
        font-family: "Avenir Next", "Segoe UI", sans-serif;
      }

      .auth-page {
        width: min(100%, 440px);
      }

      h1 {
        margin: 0 0 28px;
        font-family: Georgia, serif;
        font-size: 3rem;
        font-weight: 400;
      }

      form {
        display: flex;
        flex-direction: column;
        gap: 14px;
        padding: 28px;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: var(--paper);
      }

      label {
        font-size: 0.9rem;
        font-weight: 700;
      }

      input {
        width: 100%;
        padding: 13px 14px;
        border: 1px solid #cbd5d9;
        border-radius: 5px;
        background: #fff;
        color: var(--ink);
        font: inherit;
      }

      input:focus {
        outline: 3px solid #d8edf5;
        border-color: var(--accent);
      }

      button {
        align-self: flex-start;
        padding: 11px 18px;
        border: 1px solid var(--accent);
        border-radius: 5px;
        background: var(--accent);
        color: #fff;
        font: inherit;
        font-weight: 700;
        cursor: pointer;
      }

      button:hover {
        background: var(--accent-dark);
      }

      .auth-link {
        display: inline-block;
        margin-bottom: 28px;
        color: var(--accent);
        font-size: 0.9rem;
        font-weight: 700;
        text-decoration: none;
      }

      .auth-link:hover {
        text-decoration: underline;
      }

      @media (max-width: 600px) {
        form {
          padding: 20px;
        }
      }
 
    </style>
  </head>
  <body>
    <main class="auth-page">
    <a class="auth-link" href="/home">&larr; Back to blog</a>
    <h1>Register</h1>
    <form action="/home/register" method="POST">
      <label for="username">Username:</label>
      <input type="text" id="username" name="username" required /><br /><br />
      <label for="password">Password:</label>
      <input
        type="password"
        id="password"
        name="password"
        required
      /><br /><br />
      <button type="submit">Register</button>
    </form>
    </main>
  </body>
</html>
